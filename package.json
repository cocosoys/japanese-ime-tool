{
  "name": "japanese-ime-tool",
  "version": "1.0.0",
  "description": "Node.js 悬浮窗：抓取日文名并一键导入 Windows 微软拼音「用户自定义短语」",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "obfuscate": "node scripts/obfuscate.mjs",
    "pack": "npm run obfuscate && electron-builder --win --dir",
    "dist": "npm run obfuscate && electron-builder --win",
    "release": "node scripts/make-release.mjs",
    "test": "node test/dat-roundtrip.mjs && node test/binding.test.mjs && node test/parser.test.mjs && node test/configIntegrity.test.mjs && node test/langRecovery.test.mjs && node test/shortcuts.test.mjs && node test/batchDelete.test.mjs && node test/phraseExporters.test.mjs && node test/apiServer.test.mjs && node test/updater.test.mjs"
  },
  "dependencies": {
    "cheerio": "^1.2.0"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^26.15.3",
    "javascript-obfuscator": "^5.5.0"
  },
  "build": {
    "appId": "com.cocosoys.japaneseimetool",
    "compression": "maximum",
    "productName": "JapaneseImeTool",
    "icon": "assets/icon.ico",
    "directories": {
      "app": "build/app",
      "output": "release-v2"
    },
    "files": [
      "**/*",
      "!docs",
      "!test",
      "!scripts",
      "!*.md"
    ],
    "asar": true,
    "asarUnpack": [
      "**/data/lang/**"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "JapaneseImeTool"
    }
  },
  "updater": {
    "owner": "cocosoys",
    "repo": "japanese-ime-tool",
    "branch": "main",
    "mirror": "https://gh.xmly.dev/",
    "assetName": "app-{version}.asar"
  }
}
